<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundle's Info.plist (M12.1). Generated by CMakeLists.txt from
     port/name.cmake (name, bundle identifier), port/tools/flags.sh (the
     minimum macOS) and BF_APP_VERSION; nothing here is written by hand
     except the keys. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>@BF_APP_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>@BF_EXE@</string>
	<key>CFBundleIconFile</key>
	<string>@BF_APP_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@BF_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@BF_APP_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@BF_APP_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BF_APP_BUILD@</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.role-playing-games</string>
	<key>LSArchitecturePriority</key>
	<array>
		<string>arm64</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>@BF_MACOS_MIN@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>@BF_APP_NAME@ connects to the game server you log in to, which may be on your local network.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
